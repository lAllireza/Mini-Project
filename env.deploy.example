# این فایل رو با نام .env کنار docker-compose.deploy.yml روی سرور production بذار
# و مقادیر واقعی رو جایگزین کن. این فایل نباید داخل گیت‌هاب پوش بشه.

GITHUB_OWNER=your-github-username-or-org

DB_NAME=mydb
DB_USER=myuser
DB_PASSWORD=change-me-to-a-strong-password

DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
DJANGO_ALLOWED_HOSTS=your-domain.com